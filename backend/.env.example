# ==============================================================================
# VarshaSetu Backend Gateway — Environment Configuration Template
# ==============================================================================
# Copy this file to backend/.env for local configuration.
# Never commit actual production secrets to version control.

# ------------------------------------------------------------------------------
# 1. SERVER & DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/varshasetu
MONGODB_URI=mongodb://127.0.0.1:27017/varshasetu
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
ML_SERVICE_URL=http://localhost:8000
RATE_LIMIT_ENABLED=true

# Authentication & JWT Configuration
# In production, JWT_SECRET must be at least 32 characters and cannot be the default development secret!
JWT_SECRET=replace_with_a_secure_random_secret_min_32_chars_in_prod!
JWT_EXPIRES_IN=7d

# Demonstration Ground Anchor Coordinates (Lucknow, Bakshi Ka Talab)
DEFAULT_DEMO_STATE="Uttar Pradesh"
DEFAULT_DEMO_DISTRICT="Lucknow"
DEFAULT_DEMO_BLOCK="Bakshi Ka Talab"
DEFAULT_DEMO_LATITUDE=26.9749
DEFAULT_DEMO_LONGITUDE=80.9276

# ------------------------------------------------------------------------------
# 2. FEATURE FLAGS (Default to false; safe fallback mode preserved)
# ------------------------------------------------------------------------------
ENABLE_BHASHINI=false
ENABLE_EXTERNAL_VOICE=false
ENABLE_SMS=false
ENABLE_WHATSAPP=false
ENABLE_EMAIL=false
ENABLE_EXTERNAL_LLM=false

# ------------------------------------------------------------------------------
# 3. GOVERNMENT / INDIAN LANGUAGE SERVICES (Bhashini)
# ------------------------------------------------------------------------------
# Bhashini is disabled unless all credentials and ENABLE_BHASHINI=true are set
BHASHINI_API_BASE_URL=
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=

# ------------------------------------------------------------------------------
# 4. VOICE / TEXT-TO-SPEECH FALLBACK
# ------------------------------------------------------------------------------
# Existing MOCK_LOCAL_VOICE_ENGINE / DEMO_ONLY remains active fallback
# Google Cloud
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Azure Speech
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ElevenLabs
ELEVENLABS_API_KEY=

# ------------------------------------------------------------------------------
# 5. NOTIFICATION DELIVERY (SMS / WhatsApp)
# ------------------------------------------------------------------------------
# Delivery remains disabled unless explicitly configured and enabled
# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# WhatsApp through Twilio
TWILIO_WHATSAPP_FROM=

# Meta WhatsApp Cloud API
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_API_VERSION=

# ------------------------------------------------------------------------------
# 6. EMAIL DELIVERY
# ------------------------------------------------------------------------------
# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Resend
RESEND_API_KEY=

# SendGrid
SENDGRID_API_KEY=

# ------------------------------------------------------------------------------
# 7. MAP / GEOSPATIAL SERVICES
# ------------------------------------------------------------------------------
# Leaflet / OpenStreetMap remains the active default
# Mapbox
MAPBOX_ACCESS_TOKEN=

# Google Maps
GOOGLE_MAPS_API_KEY=

# OpenStreetMap / Nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# ------------------------------------------------------------------------------
# 8. AI / LLM SERVICES (Configuration placeholders only)
# ------------------------------------------------------------------------------
# Agronomic advice is strictly governed by deterministic rule engines.
# OpenAI
OPENAI_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 9. AUTHENTICATION / IDENTITY (Optional OAuth)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 10. OBSERVABILITY
# ------------------------------------------------------------------------------
# Sentry
SENTRY_DSN=

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=varshasetu-backend
