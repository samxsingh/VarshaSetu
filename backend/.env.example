# ==============================================================================
# VarshaSetu Backend Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit the actual .env file or real secrets to version control.
# 2. In production (NODE_ENV=production):
#    - JWT_SECRET must be explicitly set to a cryptographically secure random string >= 32 characters.
#    - JWT_REFRESH_SECRET must be set to a DIFFERENT random string >= 32 characters.
#    - Default development secrets will cause process startup failure.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=5001
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Primary Relational Store (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/varshasetu

# Document Store (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/varshasetu

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & JWT SECURITY
# ------------------------------------------------------------------------------
# Access Token Signing Secret (HMAC-SHA256, >= 32 characters in production)
JWT_SECRET=replace_with_a_secure_random_secret_min_32_chars_in_prod!
JWT_EXPIRES_IN=7d

# Refresh Token Signing Secret (MUST be distinct from JWT_SECRET, >= 32 characters in production)
JWT_REFRESH_SECRET=replace_with_a_different_secure_random_secret_min_32_chars!
JWT_REFRESH_EXPIRES_IN=30d

# Demo Account Enablement
# Set to 'true' to permit 1-click demonstration access; set to 'false' in production.
ENABLE_DEMO_ACCOUNTS=true

# ------------------------------------------------------------------------------
# 4. CORS & NETWORKING
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_ENABLED=true

# ------------------------------------------------------------------------------
# 5. ML SERVICE GATEWAY
# ------------------------------------------------------------------------------
ML_SERVICE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 6. GEOGRAPHIC REFERENCE DEFAULTS (Lucknow Centroid UP_LKO_BKT)
# ------------------------------------------------------------------------------
DEFAULT_DEMO_STATE="Uttar Pradesh"
DEFAULT_DEMO_DISTRICT="Lucknow"
DEFAULT_DEMO_BLOCK="Bakshi Ka Talab"
DEFAULT_DEMO_LATITUDE=26.9749
DEFAULT_DEMO_LONGITUDE=80.9276
