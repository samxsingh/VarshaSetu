# Server
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_ENABLED=true

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/varshasetu
MONGODB_URI=mongodb://127.0.0.1:27017/varshasetu

# Authentication
JWT_SECRET=replace_with_a_secure_random_secret_min_32_chars_in_prod!
JWT_EXPIRES_IN=7d

# ML Gateway
ML_SERVICE_URL=http://localhost:8000

# Geographic Reference Defaults
DEFAULT_DEMO_STATE="Uttar Pradesh"
DEFAULT_DEMO_DISTRICT="Lucknow"
DEFAULT_DEMO_BLOCK="Bakshi Ka Talab"
DEFAULT_DEMO_LATITUDE=26.9749
DEFAULT_DEMO_LONGITUDE=80.9276

# Feature Flags
ENABLE_BHASHINI=false
ENABLE_EXTERNAL_VOICE=false
ENABLE_SMS=false
ENABLE_WHATSAPP=false
ENABLE_EMAIL=false
ENABLE_EXTERNAL_LLM=false

# Bhashini Language Services
BHASHINI_API_BASE_URL=
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=

# Voice Services
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
ELEVENLABS_API_KEY=

# Notification Services
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_FROM=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_API_VERSION=

# Email Services
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
RESEND_API_KEY=
SENDGRID_API_KEY=

# Maps & Geospatial
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# AI & LLM Services
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Identity & OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=varshasetu-backend
