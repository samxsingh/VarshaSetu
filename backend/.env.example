# ==============================================================================
# VarshaSetu Backend Environment Configuration (.env.example)
# ==============================================================================
# Copy this template to .env for local development:
#   cp .env.example .env
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit the actual .env file or real secrets to version control.
# 2. In production (NODE_ENV=production):
#    - JWT_SECRET must be explicitly set to a cryptographically secure random string >= 32 characters.
#    - JWT_REFRESH_SECRET must be set to a DIFFERENT random string >= 32 characters.
#    - Default development secrets will cause process startup failure.
# 3. External API credentials (ECMWF, Bhashini, IMD) are optional in development;
#    if omitted, the platform gracefully operates in offline / fallback provider mode.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Port for the Express backend HTTP/WebSocket server
# Optional | Default: 5001
PORT=5001

# Execution environment: development | test | production
# Required | Default: development
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Primary Relational Store (PostgreSQL)
# Optional in offline/mock runs | Default: postgresql://postgres:postgres@localhost:5432/varshasetu
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/varshasetu

# Document Store (MongoDB) for session storage, audit logs, and caches
# Optional in offline/mock runs | Default: mongodb://127.0.0.1:27017/varshasetu
MONGODB_URI=mongodb://127.0.0.1:27017/varshasetu

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & JWT SECURITY
# ------------------------------------------------------------------------------
# Access Token Signing Secret (HMAC-SHA256, >= 32 characters in production)
# Required in production | Default: dev secret
JWT_SECRET=varshasetu_development_jwt_secret_key_32chars!

# Access Token Validity Window
# Optional | Default: 7d
JWT_EXPIRES_IN=7d

# Refresh Token Signing Secret (MUST be distinct from JWT_SECRET, >= 32 characters in production)
# Required in production | Default: dev secret
JWT_REFRESH_SECRET=varshasetu_development_refresh_secret_key_32chars!

# Refresh Token Validity Window
# Optional | Default: 30d
JWT_REFRESH_EXPIRES_IN=30d

# Demo Account Enablement
# Set to 'true' to permit 1-click demonstration access; set to 'false' in production.
# Optional | Default: true
ENABLE_DEMO_ACCOUNTS=true

# ------------------------------------------------------------------------------
# 4. CORS & NETWORKING
# ------------------------------------------------------------------------------
# Permitted origin for CORS requests from the React/Vite frontend
# Optional | Default: http://localhost:5173
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# API Rate Limiter enablement
# Optional | Default: true
RATE_LIMIT_ENABLED=true

# ------------------------------------------------------------------------------
# 5. ML SERVICE GATEWAY
# ------------------------------------------------------------------------------
# Base URL for the FastAPI Python ML service
# Optional | Default: http://localhost:8000
ML_SERVICE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 6. GEOGRAPHIC REFERENCE DEFAULTS (Lucknow Centroid UP_LKO_BKT)
# ------------------------------------------------------------------------------
# Default State name for initial farmer persona context
DEFAULT_DEMO_STATE="Uttar Pradesh"
# Default District name
DEFAULT_DEMO_DISTRICT="Lucknow"
# Default Block name
DEFAULT_DEMO_BLOCK="Bakshi Ka Talab"
# Centroid Latitude
DEFAULT_DEMO_LATITUDE=26.9749
# Centroid Longitude
DEFAULT_DEMO_LONGITUDE=80.9276

# ------------------------------------------------------------------------------
# 7. EXTERNAL PROVIDER A: ECMWF (Numerical Weather Prediction)
# ------------------------------------------------------------------------------
# Primary scientific forecasting provider for numerical weather prediction / atmospheric models.
# Obtain API key from ECMWF User Portal: https://www.ecmwf.int/en/computing/software/ecmwf-web-api
# Optional | If empty, ECMWF NWP calls gracefully bypass to secondary provider / ERA5 climatology.
ECMWF_API_KEY=

# Base URL for the ECMWF Web API service
# Optional | Default: https://api.ecmwf.int/v1
ECMWF_API_BASE_URL=https://api.ecmwf.int/v1

# ------------------------------------------------------------------------------
# 8. EXTERNAL PROVIDER B: BHASHINI (National Language Translation & Speech)
# ------------------------------------------------------------------------------
# Government of India National Language Translation Mission (NLTM) / ULCA ecosystem.
# Purpose: Voice alerts, regional dialect translation, Hindi/Marathi/Telugu/etc. text-to-speech.
# Obtain keys from Bhashini Udyat portal: https://bhashini.gov.in/
# Optional | If empty, platform gracefully uses client-side Web Speech API / static advisories.

# Bhashini User ID / Auth Key (Udyat portal credential)
# Optional | Example: your-bhashini-auth-key-uuid
BHASHINI_API_KEY=

# Bhashini Inference Service API Key for ULCA/Dhruva translation and TTS pipeline
# Optional | Example: your-bhashini-inference-api-key
BHASHINI_INFERENCE_API_KEY=

# Bhashini Dhruva Inference API Base URL
# Optional | Default: https://dhruva-api.bhashini.gov.in/services/inference/v4
BHASHINI_API_BASE_URL=https://dhruva-api.bhashini.gov.in/services/inference/v4

# Optional pipeline identifiers
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=

# Feature flag toggling Bhashini external requests
# Optional | Default: false
ENABLE_BHASHINI=false

# ------------------------------------------------------------------------------
# 9. EXTERNAL PROVIDER C: IMD (India Meteorological Department)
# ------------------------------------------------------------------------------
# Official Government of India meteorological observations, warnings, rainfall, and nowcasts.
# Base URL for the official IMD API gateway
# Optional | Default: https://api.imd.gov.in/api/v1
IMD_API_BASE_URL=https://api.imd.gov.in/api/v1

# IMD API Key / Token (if required by operational endpoint)
# Optional | If empty, IMD queries utilize public data or delegate to Open-Meteo fallback
IMD_API_KEY=

# Enablement flag for IMD queries
# Optional | Default: true
IMD_ENABLED=true

# IMD Operational Endpoint Paths (Parameters appended dynamically via query parameters)
# 1. Current Weather Endpoint (Parameters: StationId / District / State)
IMD_CURRENT_WEATHER_ENDPOINT=/current_wx

# 2. District Rainfall Endpoint (Parameters: District / State)
IMD_DISTRICT_RAINFALL_ENDPOINT=/districtrainfall

# 3. District Warning Endpoint (Parameters: District / State)
IMD_DISTRICT_WARNING_ENDPOINT=/districtwarning

# 4. District Nowcast Endpoint (Parameters: District / State)
IMD_DISTRICT_NOWCAST_ENDPOINT=/districtnowcast

# Default Geographic IDs for IMD Lookups
# Station ID (e.g. 42182 for New Delhi / Safdarjung or regional station)
IMD_DEFAULT_STATION_ID=42182
# District ID (numeric or code corresponding to IMD district index)
IMD_DEFAULT_DISTRICT_ID=164

# IMD Visualizations & GIS Products Reference URLs
# NOTE: These are strictly reference / provenance URLs for browser links, UI attribution,
# and scientific auditing. They are NOT machine-readable JSON ingestion endpoints.
IMD_RAINFALL_VISUALIZATION_URL=https://mausam.imd.gov.in/responsive/rainfallinformation.php
IMD_WARNING_VISUALIZATION_URL=https://mausam.imd.gov.in/responsive/districtWiseWarningGIS.php
IMD_NOWCAST_VISUALIZATION_URL=https://mausam.imd.gov.in/responsive/districtWiseNowcastGIS.php

# ------------------------------------------------------------------------------
# 10. METEOROLOGICAL & CLIMATE INGESTION (Secondary Providers & Caching)
# ------------------------------------------------------------------------------
# Open-Meteo High-Resolution Forecast & ECMWF SEAS5 Ensemble Ingestion
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_ENABLED=true

# NASA POWER Agroclimatological Solar, Humidity, & Evapotranspiration Ingestion
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api
NASA_POWER_ENABLED=true

# Data freshness ingestion polling interval (minutes)
DATA_REFRESH_INTERVAL_MINUTES=15

# Cache TTL for raw meteorological provider responses (minutes)
WEATHER_CACHE_TTL_MINUTES=30

# Live data ingestion toggle (when false, serves cached/baseline climatology)
LIVE_DATA_ENABLED=true

# Operational simulation toggle (when true, uses deterministic synthetic test vectors)
SIMULATION_MODE=false

# Mock providers toggle
USE_MOCK_PROVIDERS=false

# ------------------------------------------------------------------------------
# 11. ADDITIONAL OPTIONAL INTEGRATION PLACEHOLDERS
# ------------------------------------------------------------------------------
# External Voice / Notification (Twilio, WhatsApp, SMTP)
ENABLE_EXTERNAL_VOICE=false
ENABLE_SMS=false
ENABLE_WHATSAPP=false
ENABLE_EMAIL=false
ENABLE_EXTERNAL_LLM=false

# Twilio SMS / WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_FROM=

# Meta Cloud WhatsApp API
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_API_VERSION=v19.0

# SMTP / Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="VarshaSetu Alerts <alerts@varshasetu.in>"

# Observability
SENTRY_DSN=
OTEL_SERVICE_NAME=varshasetu-backend
