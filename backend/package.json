  "description": "VarshaSetu Backend Core & PostgreSQL/PostGIS Geospatial Engine",
  "main": "dist/backend/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/backend/src/server.js",
    "migrate": "tsx src/db/migrator.ts",
