# ==============================================================================
# VarshaSetu — Unified Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in the values for your local or production environment.
# Never commit actual secrets or production credentials into version control.

# ------------------------------------------------------------------------------
# 1. CORE PLATFORM & DATABASE
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5001
API_BASE_URL=http://localhost:5001/api/v1
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
ML_SERVICE_URL=http://localhost:8000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/varshasetu
MONGODB_URI=
REDIS_URL=redis://localhost:6379

# Authentication & JWT (In production, JWT_SECRET must be >= 32 chars and not default)
JWT_SECRET=replace_with_a_secure_random_secret_min_32_chars_in_prod!
JWT_EXPIRES_IN=7d

# Demonstration Ground Anchor Coordinates (Lucknow, Bakshi Ka Talab)
DEFAULT_DEMO_LOCATION={"state":"Uttar Pradesh","district":"Lucknow","block":"Bakshi Ka Talab","panchayat":"Bhaisamau","latitude":26.9856,"longitude":80.9254}
DATA_MODE=DEMO
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. FEATURE FLAGS (Default to false; safe fallback mode preserved)
# ------------------------------------------------------------------------------
ENABLE_EXTERNAL_WEATHER=false
ENABLE_CDS_DATA=false
ENABLE_SATELLITE_DATA=false
ENABLE_BHASHINI=false
ENABLE_EXTERNAL_VOICE=false
ENABLE_SMS=false
ENABLE_WHATSAPP=false
ENABLE_EMAIL=false
ENABLE_EXTERNAL_LLM=false

# ------------------------------------------------------------------------------
# 3. WEATHER / METEOROLOGICAL DATA
# ------------------------------------------------------------------------------
# OpenWeather
OPENWEATHER_API_KEY=

# WeatherAPI
WEATHERAPI_KEY=

# Tomorrow.io
TOMORROW_IO_API_KEY=

# Meteomatics
METEOMATICS_USERNAME=
METEOMATICS_PASSWORD=

# ------------------------------------------------------------------------------
# 4. CLIMATE / REANALYSIS DATA
# ------------------------------------------------------------------------------
# Copernicus Climate Data Store / CDS API
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=

# NASA Earthdata
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=
NASA_EARTHDATA_TOKEN=

# ------------------------------------------------------------------------------
# 5. SATELLITE / REMOTE SENSING
# ------------------------------------------------------------------------------
# Sentinel Hub
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# Google Earth Engine
GOOGLE_EARTH_ENGINE_PROJECT=
GOOGLE_EARTH_ENGINE_SERVICE_ACCOUNT=
GOOGLE_EARTH_ENGINE_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 6. GOVERNMENT / INDIAN LANGUAGE SERVICES (Bhashini)
# ------------------------------------------------------------------------------
# Bhashini is disabled unless all required credentials and ENABLE_BHASHINI=true are present
BHASHINI_API_BASE_URL=
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=

# ------------------------------------------------------------------------------
# 7. VOICE / TEXT-TO-SPEECH FALLBACK
# ------------------------------------------------------------------------------
# Existing MOCK_LOCAL_VOICE_ENGINE / DEMO_ONLY remains active fallback
# Google Cloud
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Azure Speech
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ElevenLabs
ELEVENLABS_API_KEY=

# ------------------------------------------------------------------------------
# 8. NOTIFICATION DELIVERY (SMS / WhatsApp)
# ------------------------------------------------------------------------------
# Delivery remains disabled unless explicitly configured and enabled
# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# WhatsApp through Twilio
TWILIO_WHATSAPP_FROM=

# Meta WhatsApp Cloud API
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_API_VERSION=

# ------------------------------------------------------------------------------
# 9. EMAIL DELIVERY
# ------------------------------------------------------------------------------
# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Resend
RESEND_API_KEY=

# SendGrid
SENDGRID_API_KEY=

# ------------------------------------------------------------------------------
# 10. MAP / GEOSPATIAL SERVICES
# ------------------------------------------------------------------------------
# Leaflet / OpenStreetMap remains the active default
# Mapbox
MAPBOX_ACCESS_TOKEN=

# Google Maps
GOOGLE_MAPS_API_KEY=

# OpenStreetMap / Nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# ------------------------------------------------------------------------------
# 11. AI / LLM SERVICES (Configuration placeholders only)
# ------------------------------------------------------------------------------
# Agronomic advice is strictly governed by deterministic rule engines.
# LLMs are never used for yield, biomass, or meteorological calibration.
# OpenAI
OPENAI_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 12. AUTHENTICATION / IDENTITY (Optional OAuth)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 13. OBSERVABILITY
# ------------------------------------------------------------------------------
# Sentry
SENTRY_DSN=

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=varshasetu
