# ==============================================================================
# VarshaSetu Monorepo Environment Configuration Reference (.env.example)
# ==============================================================================
# This root file illustrates the complete multi-tier configuration parameters.
# For individual workspaces, refer to their dedicated local configuration files:
#   - Backend:    backend/.env.example  ->  backend/.env
#   - Frontend:   frontend/.env.example ->  frontend/.env
#   - ML Service: ml-service/.env.example -> ml-service/.env
#
# DO NOT commit real secrets or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. BACKEND API SERVER (PORT: 5001)
# ------------------------------------------------------------------------------
PORT=5001
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_ENABLED=true

# Databases
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/varshasetu
MONGODB_URI=mongodb://127.0.0.1:27017/varshasetu

# Authentication & Tokens
# NOTE: Replace with cryptographically secure strings (>= 32 chars) in production!
JWT_SECRET=replace_with_a_secure_random_secret_min_32_chars_in_prod!
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_a_different_secure_random_secret_min_32_chars!
JWT_REFRESH_EXPIRES_IN=30d
ENABLE_DEMO_ACCOUNTS=true

# ------------------------------------------------------------------------------
# 3. FRONTEND CLIENT (PORT: 5173)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5001/api/v1
VITE_WS_URL=http://localhost:5001

# ------------------------------------------------------------------------------
# 4. ML SERVICE GATEWAY (PORT: 8000)
# ------------------------------------------------------------------------------
ML_SERVICE_URL=http://localhost:8000
BACKEND_URL=http://localhost:5001

# ------------------------------------------------------------------------------
# 5. SCIENTIFIC & GEOGRAPHIC REFERENCE DEFAULTS (Lucknow UP_LKO_BKT)
# ------------------------------------------------------------------------------
DEFAULT_DEMO_STATE="Uttar Pradesh"
DEFAULT_DEMO_DISTRICT="Lucknow"
DEFAULT_DEMO_BLOCK="Bakshi Ka Talab"
DEFAULT_DEMO_LATITUDE=26.9749
DEFAULT_DEMO_LONGITUDE=80.9276

# Meteorological Threshold Definitions
DRY_DAY_THRESHOLD_MM=1.0
HEAVY_RAIN_THRESHOLD_MM=64.5
EXTREME_RAIN_THRESHOLD_MM=115.5

# ------------------------------------------------------------------------------
# 6. EXTERNAL DATA PROVIDERS FOUNDATION
# ------------------------------------------------------------------------------
# Provider A: ECMWF (Numerical Weather Prediction)
# Optional | Default: https://api.ecmwf.int/v1
ECMWF_API_KEY=
ECMWF_API_BASE_URL=https://api.ecmwf.int/v1

# Provider B: BHASHINI (National Language Translation & Voice)
# Optional | Default: https://dhruva-api.bhashini.gov.in/services/inference/v4
BHASHINI_API_KEY=
BHASHINI_INFERENCE_API_KEY=
BHASHINI_API_BASE_URL=https://dhruva-api.bhashini.gov.in/services/inference/v4
ENABLE_BHASHINI=false

# Provider C: IMD (India Meteorological Department Observations, Warnings, & Nowcasts)
# Optional | Default: https://api.imd.gov.in/api/v1
IMD_API_BASE_URL=https://api.imd.gov.in/api/v1
IMD_API_KEY=
IMD_ENABLED=true
IMD_CURRENT_WEATHER_ENDPOINT=/current_wx
IMD_DISTRICT_RAINFALL_ENDPOINT=/districtrainfall
IMD_DISTRICT_WARNING_ENDPOINT=/districtwarning
IMD_DISTRICT_NOWCAST_ENDPOINT=/districtnowcast
IMD_DEFAULT_STATION_ID=42182
IMD_DEFAULT_DISTRICT_ID=164

# IMD Reference / Visualization URLs (Provenance & auditing, NOT machine ingestion)
IMD_RAINFALL_VISUALIZATION_URL=https://mausam.imd.gov.in/responsive/rainfallinformation.php
IMD_WARNING_VISUALIZATION_URL=https://mausam.imd.gov.in/responsive/districtWiseWarningGIS.php
IMD_NOWCAST_VISUALIZATION_URL=https://mausam.imd.gov.in/responsive/districtWiseNowcastGIS.php

# ------------------------------------------------------------------------------
# 7. METEOROLOGICAL & CLIMATE INGESTION (Secondary Providers & Caching)
# ------------------------------------------------------------------------------
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_ENABLED=true

NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api
NASA_POWER_ENABLED=true

DATA_REFRESH_INTERVAL_MINUTES=15
WEATHER_CACHE_TTL_MINUTES=30
LIVE_DATA_ENABLED=true

# Operational simulation toggle (when true, uses deterministic synthetic test vectors)
SIMULATION_MODE=false
USE_MOCK_PROVIDERS=false
