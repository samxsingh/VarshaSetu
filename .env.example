# ==============================================================================
# VarshaSetu - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in the values for your local or production environment.
# Never commit actual secrets or production credentials into version control.

# Node / Express Backend
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000/api/v1
CORS_ORIGIN=http://localhost:5173

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_secret_min_32_chars
JWT_EXPIRES_IN=7d

# Database Configuration (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/varshasetu?schema=public

# Caching & Background Queues (Redis)
REDIS_URL=redis://localhost:6379

# Python ML Microservice
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_PORT=8000
ML_SERVICE_ENV=development

# Geographic Default Configuration
# Format: JSON string or composite identifier for fallback initial location
# Note: Application business logic must never hard-code location names; this serves as configurable UI initialization.
DEFAULT_DEMO_LOCATION={"state":"Uttar Pradesh","district":"Lucknow","block":"Bakshi Ka Talab","panchayat":"Bhaisamau","latitude":26.9856,"longitude":80.9254}

# Data Operating Mode: REAL or DEMO
# In DEMO mode, forecasts, advisories, and observations carry explicit simulation labels.
# In REAL mode, only verified pipeline and ingested observations are surfaced.
DATA_MODE=DEMO

# Observability & Logging
LOG_LEVEL=info

# Future Integration Placeholders (Do not enable in Phase 1A)
# BHASHINI_API_KEY=
# BHASHINI_USER_ID=
# BHASHINI_PIPELINE_ID=
