# Server
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_ENABLED=true

# Frontend
VITE_API_BASE_URL=http://localhost:5001/api/v1
VITE_MAPBOX_TOKEN=

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/varshasetu
MONGODB_URI=mongodb://127.0.0.1:27017/varshasetu

# Authentication
JWT_SECRET=replace_with_a_secure_random_secret_min_32_chars_in_prod!
JWT_EXPIRES_IN=7d

# ML Gateway
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_PORT=8000

# Geographic Reference Defaults
DEFAULT_DEMO_STATE="Uttar Pradesh"
DEFAULT_DEMO_DISTRICT="Lucknow"
DEFAULT_DEMO_BLOCK="Bakshi Ka Talab"
DEFAULT_DEMO_LATITUDE=26.9749
DEFAULT_DEMO_LONGITUDE=80.9276

# Meteorological Thresholds
DRY_DAY_THRESHOLD_MM=1.0
HEAVY_RAIN_THRESHOLD_MM=64.5
EXTREME_RAIN_THRESHOLD_MM=115.5

# Feature Flags
ENABLE_EXTERNAL_WEATHER=false
ENABLE_CDS_DATA=false
ENABLE_SATELLITE_DATA=false
ENABLE_BHASHINI=false
ENABLE_EXTERNAL_VOICE=false
ENABLE_SMS=false
ENABLE_WHATSAPP=false
ENABLE_EMAIL=false
ENABLE_EXTERNAL_LLM=false

# Weather & Meteorological APIs
OPENWEATHER_API_KEY=
WEATHERAPI_KEY=
TOMORROW_IO_API_KEY=
METEOMATICS_USERNAME=
METEOMATICS_PASSWORD=

# Climate & Reanalysis Data
