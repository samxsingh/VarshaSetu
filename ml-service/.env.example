# Server
NODE_ENV=development
ML_SERVICE_PORT=8000
CORS_ORIGIN=http://localhost:5173,http://localhost:5001

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/varshasetu

# Geographic Reference Defaults
DEFAULT_LATITUDE=26.9749
DEFAULT_LONGITUDE=80.9276

# Meteorological Thresholds
DRY_DAY_THRESHOLD_MM=1.0
HEAVY_RAIN_THRESHOLD_MM=64.5
EXTREME_RAIN_THRESHOLD_MM=115.5

# Feature Flags
ENABLE_EXTERNAL_WEATHER=false
ENABLE_CDS_DATA=false
ENABLE_SATELLITE_DATA=false
ENABLE_BHASHINI=false
ENABLE_EXTERNAL_VOICE=false

# Weather & Meteorological APIs
OPENWEATHER_API_KEY=
WEATHERAPI_KEY=
TOMORROW_IO_API_KEY=
METEOMATICS_USERNAME=
METEOMATICS_PASSWORD=

# Climate & Reanalysis Data
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=
NASA_EARTHDATA_TOKEN=

# Satellite & Remote Sensing
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
GOOGLE_EARTH_ENGINE_PROJECT=
GOOGLE_EARTH_ENGINE_SERVICE_ACCOUNT=
GOOGLE_EARTH_ENGINE_PRIVATE_KEY=

# Bhashini Language Services
BHASHINI_API_BASE_URL=
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=varshasetu-ml
