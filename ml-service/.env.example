# ==============================================================================
# VarshaSetu ML & Meteorological Service — Environment Configuration
# ==============================================================================
# Environment: 'development' | 'test' | 'production'
NODE_ENV=development

# Microservice Port (Default: 8000)
ML_SERVICE_PORT=8000

# PostgreSQL Connection String (must match backend database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/varshasetu

# CORS Allowed Origins (Comma-separated in production)
CORS_ORIGIN=http://localhost:5173,http://localhost:5001

# Operational Mode
# In Phase 6, all meteorological and agricultural forecasts operate strictly in DIAGNOSTIC_ONLY
OPERATIONAL_MODE=DIAGNOSTIC_ONLY

# Scientific Demonstration Ground Anchor Coordinates
DEFAULT_LATITUDE=26.9749
DEFAULT_LONGITUDE=80.9276

# Meteorological Thresholds (IMD Standards)
DRY_DAY_THRESHOLD_MM=1.0
HEAVY_RAIN_THRESHOLD_MM=64.5
EXTREME_RAIN_THRESHOLD_MM=115.5

# External Provider Credentials (Disabled / NOT_CONFIGURED by default)
# BHASHINI_API_KEY=
# BHASHINI_USER_ID=
# BHASHINI_PIPELINE_ID=
