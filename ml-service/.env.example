# ==============================================================================
# VarshaSetu ML Service Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# Storage directories (data, models, artifacts) are resolved relative to the
# ml-service root directory dynamically and do not require hardcoded machine paths.
# ==============================================================================

# Server & Networking
PORT=8000
ENVIRONMENT=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5001
BACKEND_URL=http://localhost:5001

# Database Connection (matches backend PostgreSQL store)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/varshasetu

# Geographic Reference Defaults (Lucknow Centroid UP_LKO_BKT)
DEFAULT_LATITUDE=26.9749
DEFAULT_LONGITUDE=80.9276

# Meteorological Scientific Feature Thresholds
DRY_DAY_THRESHOLD_MM=1.0
HEAVY_RAIN_THRESHOLD_MM=64.5
EXTREME_RAIN_THRESHOLD_MM=115.5

# External Data Provider Foundations (Phase 1)
# ECMWF NWP API Access (Optional for ML service atmospheric feature extraction)
ECMWF_API_KEY=
ECMWF_API_BASE_URL=https://api.ecmwf.int/v1
