# ==============================================================================
# VarshaSetu ML & Meteorological Service — Environment Configuration Template
# ==============================================================================
# Copy this file to ml-service/.env for local configuration.
# Never commit actual production secrets to version control.

# ------------------------------------------------------------------------------
# 1. CORE SERVER & RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=development
ML_SERVICE_PORT=8000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/varshasetu
CORS_ORIGIN=http://localhost:5173,http://localhost:5001

# Operational Mode
# In Phase 6, all meteorological and agricultural forecasts operate strictly in DIAGNOSTIC_ONLY
OPERATIONAL_MODE=DIAGNOSTIC_ONLY

# Scientific Demonstration Ground Anchor Coordinates
DEFAULT_LATITUDE=26.9749
DEFAULT_LONGITUDE=80.9276

# Meteorological Thresholds (IMD Standards)
DRY_DAY_THRESHOLD_MM=1.0
HEAVY_RAIN_THRESHOLD_MM=64.5
EXTREME_RAIN_THRESHOLD_MM=115.5

# ------------------------------------------------------------------------------
# 2. FEATURE FLAGS (Default to false; offline empirical archive fallback preserved)
# ------------------------------------------------------------------------------
ENABLE_EXTERNAL_WEATHER=false
ENABLE_CDS_DATA=false
ENABLE_SATELLITE_DATA=false
ENABLE_BHASHINI=false
ENABLE_EXTERNAL_VOICE=false

# ------------------------------------------------------------------------------
# 3. WEATHER / METEOROLOGICAL DATA
# ------------------------------------------------------------------------------
# OpenWeather
OPENWEATHER_API_KEY=

# WeatherAPI
WEATHERAPI_KEY=

# Tomorrow.io
TOMORROW_IO_API_KEY=

# Meteomatics
METEOMATICS_USERNAME=
METEOMATICS_PASSWORD=

# ------------------------------------------------------------------------------
# 4. CLIMATE / REANALYSIS DATA
# ------------------------------------------------------------------------------
# Copernicus Climate Data Store / CDS API
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=

# NASA Earthdata
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=
NASA_EARTHDATA_TOKEN=

# ------------------------------------------------------------------------------
# 5. SATELLITE / REMOTE SENSING
# ------------------------------------------------------------------------------
# Sentinel Hub
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# Google Earth Engine
GOOGLE_EARTH_ENGINE_PROJECT=
GOOGLE_EARTH_ENGINE_SERVICE_ACCOUNT=
GOOGLE_EARTH_ENGINE_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 6. GOVERNMENT / INDIAN LANGUAGE SERVICES (Bhashini)
# ------------------------------------------------------------------------------
# Bhashini is disabled unless all required credentials and ENABLE_BHASHINI=true are present
BHASHINI_API_BASE_URL=
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=

# ------------------------------------------------------------------------------
# 7. OBSERVABILITY
# ------------------------------------------------------------------------------
# Sentry
SENTRY_DSN=

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=varshasetu-ml
