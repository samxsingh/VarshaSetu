# ==============================================================================
# VarshaSetu Frontend Environment Configuration (.env.example)
# ==============================================================================
# Vite requires public frontend environment variables to be prefixed with VITE_.
#
# IMPORTANT SECURITY POLICY:
# NEVER include sensitive backend credentials or secret API keys in this file:
# - DO NOT put ECMWF_API_KEY here.
# - DO NOT put BHASHINI_API_KEY or BHASHINI_INFERENCE_API_KEY here.
# - DO NOT put IMD_API_KEY or JWT_SECRET here.
# All external provider requests and secure pipelines must flow through the backend.
# ==============================================================================

# API Gateway Base URL
# Development default uses Vite reverse proxy '/api/v1' or direct backend URL
VITE_API_BASE_URL=http://localhost:5001/api/v1

# Real-Time WebSocket / Socket.IO URL
VITE_WS_URL=http://localhost:5001

# Public Reference & Provenance URLs (Read-only external browser links)
VITE_IMD_RAINFALL_URL=https://mausam.imd.gov.in/responsive/rainfallinformation.php
VITE_IMD_WARNING_URL=https://mausam.imd.gov.in/responsive/districtWiseWarningGIS.php
VITE_IMD_NOWCAST_URL=https://mausam.imd.gov.in/responsive/districtWiseNowcastGIS.php

# Optional: Mapbox GL Access Token for GIS mapping layer (falls back to OpenStreetMap)
# VITE_MAPBOX_TOKEN=
