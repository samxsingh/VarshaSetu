# ==============================================================================
# VarshaSetu Frontend Web Client — Environment Configuration Template
# ==============================================================================
# Copy this file to frontend/.env for local configuration.
# WARNING: NEVER place API keys, private credentials, or secrets in this file.
# Only public configuration variables prefixed with VITE_ are permitted here.

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:5001/api/v1

# ML Service Direct Diagnostic Endpoint (optional)
VITE_ML_SERVICE_URL=http://localhost:8000

# Public Mapbox Token (Optional vector map tiles; Leaflet fallback default)
VITE_MAPBOX_PUBLIC_TOKEN=

# Default Language ('en' or 'hi')
VITE_DEFAULT_LANGUAGE=en

# Demo Operational Mode
VITE_OPERATIONAL_MODE=DIAGNOSTIC_ONLY
